es "}, {"type": "math", "latex": "\\mathcal{A} \\lor \\mathcal{B}", "display": false}, {"type": "text", "text": " true. So in particular, "}, {"type": "math", "latex": "v", "display": false}, {"type": "text", "text": " makes "}, {"type": "math", "latex": "\\mathcal{A} \\lor \\mathcal{B}", "display": false}, {"type": "text", "text": " true, and hence either "}, {"type": "math", "latex": "v", "display": false}, {"type": "text", "text": " makes "}, {"type": "math", "latex": "\\mathcal{A}", "display": false}, {"type": "text", "text": " true, or "}, {"type": "math", "latex": "v", "display": false}, {"type": "text", "text": " makes "}, {"type": "math", "latex": "\\mathcal{B}", "display": false}, {"type": "text", "text": " true. We now reason through these two cases:"}]}, {"type": "list", "kind": "numberlist", "items": [{"children": [{"type": "para", "children": [{"type": "emph", "children": [{"type": "math", "latex": "v", "display": false}, {"type": "text", "text": " makes "}, {"type": "math", "latex": "\\mathcal{A}", "display": false}, {"type": "text", "text": " true."}]}, {"type": "text", "text": " All of "}, {"type": "math", "latex": "\\Delta_i", "display": false}, {"type": "text", "text": " are among "}, {"type": "math", "latex": "\\Delta_{n}", "display": false}, {"type": "text", "text": ", with the possible exception of "}, {"type": "math", "latex": "\\mathcal{A}", "display": false}, {"type": "text", "text": ". Since "}, {"type": "math", "latex": "v", "display": false}, {"type": "text", "text": " makes all of "}, {"type": "math", "latex": "\\Delta_{n}", "display": false}, {"type": "text", "text": " true, and also makes "}, {"type": "math", "latex": "\\mathcal{A}", "display": false}, {"type": "text", "text": " true, "}, {"type": "math", "latex": "v", "display": false}, {"type": "text", "text": " makes all of "}, {"type": "math", "latex": "\\Delta_i", "display": false}, {"type": "text", "text": " true. Now, by assumption, line "}, {"type": "math", "latex": "j", "displa